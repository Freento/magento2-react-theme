# --- Vike SSR configuration ---

# URL the browser hits. Relative path is proxied via Vite/Express to GRAPHQL_ORIGIN.
VITE_GRAPHQL_URL=/graphql

# Origin used server-side (during SSR) and by the dev/prod proxy to reach Magento.
GRAPHQL_ORIGIN=https://m248.loc
# Set to "true" when Magento uses a self-signed TLS cert (e.g. *.loc) so the proxy skips verification.
GRAPHQL_INSECURE=false

# --- Magento DB (direct connection) ---
# Used by the dev and prod Node servers to resolve catalog URLs (url_rewrite lookup)
# before rendering. Categories come from the generated category map instead.
MAGENTO_DB_HOST=host.docker.internal
MAGENTO_DB_PORT=3306
MAGENTO_DB_NAME=magento
MAGENTO_DB_USER=root
MAGENTO_DB_PASSWORD=
MAGENTO_DB_TABLE_PREFIX=
# Magento store view code used when resolving URLs (empty = default active store).
MAGENTO_STORE_CODE=default

# Checkout mode: "react" uses the internal /checkout page; "magento" POSTs the quote
# to /checkout/index/index and lets Magento render its native checkout.
VITE_CHECKOUT_MODE=react

# --- Ports ---
# Several copies of the project can run on one machine, each folder has its own .env.
# Give every process its own port and the copies stop colliding. Inside Docker the
# container is one instance: only the storefront port is published (HOST_PORT), the
# editor stays on loopback behind the storefront's /editor proxy.
# Port published on the host machine (docker-compose.yml)
HOST_PORT=8250
# Storefront port: server.prod.js, and the port docker publishes from the container.
PORT=3000
# server.dev.js (EDITOR_ENABLED=on + EDITOR_MODE=dev). Falls back to PORT when empty;
# leave it empty in Docker so the dev layout listens on the published PORT.
DEV_PORT=
# editor-app/server.js (EDITOR_ENABLED=on)
EDITOR_PORT=3100
# Vite HMR websocket port advertised to the browser in dev
HMR_PORT=24680

# Visual page editor. "on" runs editor-app + proxies /editor, /__preview__, /_editor, /api/render.
# Set "off" to skip the editor process entirely on dev and stop the prod proxy from forwarding.
EDITOR_ENABLED=on
# How the editor itself runs (only read when EDITOR_ENABLED=on):
#   dev  - vite dev server, everything served from source. Default.
#   prod - the built editor from editor-app/dist, no vite, no HMR websocket.
#          Requires `npm run build:editor` (part of `npm run build`); the editor
#          process refuses to start without it. Rebuilding on a running server is
#          safe - open tabs notice the new build and reload themselves.
# In Docker it is read by scripts/start.js (docker-compose.yml).
EDITOR_MODE=dev
# Editor routes are proxied to http://localhost:${EDITOR_PORT} automatically.
# Only if the editor runs on another host, point the proxy there explicitly:
# EDITOR_APP_URL=http://editor-host:3100
# Interface the editor process binds to. Loopback by default: the storefront
# proxies /editor from the same machine, and a port reachable from outside would
# serve the editor without passing the guard below. Only change it together with
# EDITOR_APP_URL when the editor genuinely runs elsewhere.
# EDITOR_HOST=127.0.0.1

# Save button in the editor. "disabled" greys it out together with the page operations
# (create, edit, duplicate, hide, delete, storefront page by URL; SAVE_BUTTON_TOOLTIP shown
# on hover) and makes the editor API refuse saves, pushes and those operations with 403 -
# for demo instances.
# Any other value, or unset, leaves Save working. Read at runtime: restart, no rebuild.
SAVE_BUTTON=
SAVE_BUTTON_TOOLTIP="Save is disabled on this demo instance"

# Hostname allowed through Vite's host-check when a reverse proxy (e.g. nginx) serves the
# dev server under a custom domain. Leave empty if you access vite directly on localhost.
VITE_ALLOWED_HOST=

# Git identity used by the editor container when Save / Push run `git commit` / `git push`.
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- Basic Auth (whole site) ----------------------------------------------------
# In-process HTTP Basic Auth on the dev and prod servers, e.g. to keep a staging
# instance away from search engines and passers-by. Off unless all three are set.
# Requests carrying `Authorization: Bearer` (Magento customer token) pass through.
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Realm string shown in the browser's login prompt.
BASIC_AUTH_REALM=Restricted

# --- Editor login ---------------------------------------------------------------
# Guards /editor, /__preview__, /_editor, /api/editor and /api/render only - the
# storefront itself stays open. Two layers, each switched on by its own flag:
#
# 1. Gate (EDITOR_AUTH_*): HTTP Basic Auth with a shared pair. It keeps the
# sign-in form below out of reach, so nobody without the pair can guess admin
# passwords through the editor. Separate from BASIC_AUTH on purpose: a staging
# password is usually known to everyone who needs the staging, which is not the
# group that should be able to rewrite the site. Unlike BASIC_AUTH, it has no
# bearer-token bypass. After it succeeds the browser keeps a signed gate cookie
# for 7 days (key derived from the pair, so changing the password closes the
# gate for everyone).
#
# 2. Admin sign-in (EDITOR_ADMIN_AUTH_*). Uses Magento admin accounts: the guard
# trades the user name and password for an admin token (REST
# /V1/integration/admin/token) and lets in any role allowed to edit CMS pages
# (Magento_Cms::page), asking the Magento at GRAPHQL_ORIGIN through its /rest
# routes. The session cookie is encrypted with EDITOR_ADMIN_AUTH_SECRET and
# expires with the admin token (oauth/access_token_lifetime/admin, 4 hours by
# default). Every save checks the token with Magento again, so Force Sign-In in
# the admin or removing the CMS right from the role stops the admin at the next
# save. Commits made by the editor carry "Editor-User: #<admin id> <user name>".
# With Magento_TwoFactorAuth on, the sign-in also asks for the Google
# Authenticator code; admins on another 2FA provider (U2F key, Duo) cannot sign
# in to the editor, those only work inside the Magento admin.
# Failed sign-ins are limited within 15 minutes: 3 per IP and user name, 5 per
# user name (Magento itself locks an admin after 6), 10 per IP.
#
# The gate pair and a live editor session also open BASIC_AUTH: the editor page
# loads /uploads and its preview queries /graphql, neither of which is an editor
# route.
# Leaving both off is allowed - the storefront logs a warning at startup, and the
# editor routes fall back to BASIC_AUTH when that one is on.
EDITOR_AUTH_ENABLED=false
EDITOR_AUTH_USER=
EDITOR_AUTH_PASSWORD=
# Shown in the browser's password prompt.
EDITOR_AUTH_REALM=Editor
EDITOR_ADMIN_AUTH_ENABLED=false
# Random string, e.g. `openssl rand -hex 32`. Changing it signs every editor out.
EDITOR_ADMIN_AUTH_SECRET=

# --- Debug ---
# GraphQL instrumentation for SSR. Server-side only — deliberately no VITE_ prefix, so
# Vite never inlines it into the client bundle and it cannot reach the browser.
#   off    (default) nothing is collected; the render pays nothing
#   header response headers only (X-Ssr-Gql-Count / -Ms / -Passes / -Errors / -Bytes /
#          -Ops, X-Ssr-Renders, X-Ssr-Ms). X-Ssr-Gql-Ms is the sum of the queries'
#          durations — they overlap, so it can exceed X-Ssr-Ms (the render's wall-clock).
#          X-Ssr-Gql-Passes above 1 means a query had to wait on an earlier one.
#          Prerendered pages (/, /about, …) are served as static files and emit nothing.
#   log    one [ssr-gql] line per SSR on the server's stdout
#   file   collect, but emit neither headers nor stdout — only the file below
#   full   headers and stdout, and the stdout line prints each operation's variables
SSR_DEBUG=off

# File name for the SSR instrumentation's NDJSON records — one JSON object per SSR,
# carrying the full outgoing GraphQL request. Empty = no file.
# This is a NAME, not a path: it is always resolved inside var/log/ and confined there,
# so an absolute path or one climbing out with `..` is refused, not honoured.
# A subdirectory (e.g. ssr/gql.ndjson) is fine; it is created on first write.
# Works in every SSR_DEBUG mode except `off`; use SSR_DEBUG=file for the file alone.
SSR_DEBUG_FILE=ssr-gql.ndjson
# Size cap in MB. On reaching it the file is renamed to *.ndjson.1 (one generation
# kept) and a fresh one starts — nothing else rotates it.
SSR_DEBUG_FILE_MAX_MB=64
