{
  "name": "simpleshop",
  "version": "1.0.0",
  "description": "SimpleShop - React storefront for Magento 2 (SSR + build-time prerender)",
  "type": "module",
  "workspaces": [
    "editor-app",
    "editor-app/packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:storefront": "node server.dev.js",
    "dev:editor": "npm --workspace editor-app run dev",
    "build": "npm run build:client && npm run build:server && npm run build:menu-ids && npm run build:prerender && npm run build:editor",
    "build:client": "vite build --outDir dist/client --manifest",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "build:menu-ids": "node scripts/resolve-menu-ids.js",
    "build:prerender": "node scripts/prerender.js",
    "build:editor": "npm --workspace editor-app run build",
    "start": "node scripts/start.js",
    "start:storefront": "node --env-file=.env server.prod.js",
    "preview": "npm run build && npm run start",
    "maintenance:on": "node scripts/maintenance.js on",
    "maintenance:off": "node scripts/maintenance.js off"
  },
  "dependencies": {
    "@apollo/client": "^3.7.7",
    "beasties": "^0.5.4",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "editor-core": "*",
    "express": "^4.19.2",
    "express-basic-auth": "^1.2.1",
    "graphql": "^16.6.0",
    "http-proxy-middleware": "^3.0.0",
    "mysql2": "^3.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "sirv": "^2.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^3.4.19",
    "vite": "^6.3.0",
    "vite-plugin-compression": "^0.5.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
